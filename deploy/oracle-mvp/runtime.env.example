# Operator-owned files; no passwords, wallets or OCI administration key in Git.
AUTO_ONTOLOGY_ORACLE_CONFIG=/var/lib/auto-ontology/oracle/config.json
AUTO_ONTOLOGY_ORACLE_GATEWAY_KEY_FILE=/var/lib/auto-ontology/oracle/gateway-key
DEFAULT_MODELS_ENDPOINT=http://127.0.0.1:11435/v1
DEFAULT_MODELS_MODEL=openai/local-ontology
DEFAULT_MODELS_API_KEY=local-no-billing
REASONING_ENDPOINT=http://127.0.0.1:11435/v1
REASONING_MODEL=openai/local-ontology
REASONING_API_KEY=local-no-billing
NON_REASONING_ENDPOINT=http://127.0.0.1:11435/v1
NON_REASONING_MODEL=openai/local-ontology
NON_REASONING_API_KEY=local-no-billing
EMBED_ENDPOINT=http://127.0.0.1:11435/v1
EMBED_MODEL=all-minilm
EMBED_API_KEY=local-no-billing
RERANK_ENDPOINT=http://127.0.0.1:11435/v1/rerank
RERANK_MODEL=unused-local-only
RERANK_API_KEY=local-no-billing
LLM_MAX_INFLIGHT=1
LLM_INVOKE_TIMEOUT_S=180
